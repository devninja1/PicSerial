<Window x:Class="PicSerial.MainWindow"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="PicSerial"
        Height="auto"
        Width="600"
        xmlns:local="clr-namespace:PicSerial" WindowStartupLocation="CenterScreen"
         Loaded="Window_Loaded" Closing="Window_Closing" RenderTransformOrigin="0.5,0.5">
    <Window.RenderTransform>
        <ScaleTransform ScaleX="1" ScaleY="1"/>
    </Window.RenderTransform>
    <Window.Resources>
        <local:WidthToColumnsConverter x:Key="WidthToColumnsConverter"/>
        <Style TargetType="Border" x:Key="ThumbnailBorderStyle">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="SizeChanged">
                    <BeginStoryboard>
                        <Storyboard>
                            <!-- Smooth scale animation -->
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                         From="0.9" To="1" Duration="0:0:0.3"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                         From="0.9" To="1" Duration="0:0:0.3"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Storyboard x:Key="StatusTextBounce" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="StatusCounterTransform"
                         Storyboard.TargetProperty="X"
                         From="0" To="10"
                         Duration="0:0:0.5" />
        </Storyboard>
    </Window.Resources>

    <Grid>
        <DockPanel LastChildFill="True">

            <!-- Top toolbar -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="#EEE" Height="50">
                <!-- New Folder -->
                <Button x:Name="BtnNewFolder" Click="BtnNewFolder_Click" Width="60" Height="50" Margin="5,0">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="FolderPlus" Width="20" Height="20" HorizontalAlignment="Center"/>
                        <TextBlock Text="New" FontSize="10" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Open Folder -->
                <Button x:Name="BtnOpenFolder" Click="BtnOpenFolder_Click" Width="60" Height="50" Margin="5,0">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="FolderOpen" Width="20" Height="20" HorizontalAlignment="Center"/>
                        <TextBlock Text="Open" FontSize="10" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Clear Previews -->
                <Button x:Name="BtnClearPreviews" Click="BtnClearPreviews_Click" Width="60" Height="50" Margin="5,0">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="DeleteSweep" Width="20" Height="20" HorizontalAlignment="Center"/>
                        <TextBlock Text="Clear" FontSize="10" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Show Folder -->
                <Button x:Name="BtnShowFolder" Click="BtnShowFolder_Click" Width="60" Height="50" Margin="5,0">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="FolderEye" Width="20" Height="20" HorizontalAlignment="Center"/>
                        <TextBlock Text="Show" FontSize="10" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Refresh Serial -->
                <Button Click="RenameSerial_Click" Width="80" Height="50" Margin="5,0">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="Refresh" Width="20" Height="20" HorizontalAlignment="Center"/>
                        <TextBlock Text="Refresh/Rename" FontSize="10" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>



                <!-- Spacer pushes status bar items to the right -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <StatusBar Background="#EEE" Height="22">
                        <StatusBarItem>
                            <TextBlock x:Name="StatusFolder" Text="No folder selected" FontSize="11"/>
                        </StatusBarItem>
                        <StatusBarItem>
                            <TextBlock x:Name="StatusCounter"         FontWeight="Bold"  RenderTransformOrigin="0.5,0.5" Text="Images copied: 0">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="StatusCounterTransform" />
                                </TextBlock.RenderTransform>
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF00C6FF" Offset="0.0"/>
                                        <GradientStop Color="#FF0072FF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                               
                            </TextBlock>


                        </StatusBarItem>
                    </StatusBar>
                </StackPanel>
            </StackPanel>
            <!-- Drag-drop area -->
            <Border DockPanel.Dock="Top" Margin="5" BorderBrush="Gray" BorderThickness="2"
                    AllowDrop="True" DragEnter="DragArea_DragEnter" Drop="DragArea_Drop"                    Background="LightGray">
                <ScrollViewer MinHeight="400" HorizontalScrollBarVisibility="Disabled"   PanningMode="VerticalOnly"    VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="ThumbnailList" ItemsSource="{Binding Images}"  
                          ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"    PreviewMouseWheel="ThumbnailList_PreviewMouseWheel"  PreviewMouseLeftButtonDown="ThumbnailList_PreviewMouseLeftButtonDown" MouseMove="ThumbnailList_MouseMove" Drop="ThumbnailList_Drop">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- UniformGrid ensures fixed number of columns -->
                                <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource WidthToColumnsConverter}}"   VerticalAlignment="Top" IsItemsHost="True" />

                                <!-- WrapPanel adapts to window width -->
                                <!--<WrapPanel Orientation="Horizontal" />-->
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical" Margin="5" Width="150">
                                    <!-- Viewbox scales the image automatically -->
                                    <Border Style="{StaticResource ThumbnailBorderStyle}" BorderBrush="Gray" BorderThickness="1" Margin="2">
                                        <Viewbox Stretch="Uniform" MaxWidth="150" MaxHeight="150">
                                            <Image Source="{Binding Thumbnail}" Width="100" Height="100" Stretch="Uniform" MinHeight="120" />
                                        </Viewbox>
                                    </Border>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="10"
                               TextAlignment="Center" TextWrapping="Wrap"
                               ToolTip="{Binding OriginalPath}"/>

                                    <!-- Context menu -->
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Open New File"
                                  Click="OpenNewFile_Click"/>
                                            <MenuItem Header="Open Original File"
                                  Click="OpenOriginalFile_Click"/>
                                            <Separator/>
                                            <MenuItem Header="Delete New File"
                                  Click="DeleteNewFile_Click"/>
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Border>
            <!-- Rest of your layout -->
        </DockPanel>

        <!-- Loader overlay (dims background, centered spinner + message) -->
        <Grid x:Name="LoaderOverlay"
          Background="#80000000"
          Visibility="Collapsed"
          Opacity="0">
            <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Vertical"
                    Margin="20">
                <Viewbox Width="100" Height="100" Margin="0,0,0,15">
                    <Canvas Width="100" Height="100">
                        <Ellipse Width="60" Height="60" Stroke="White" StrokeThickness="6"
                             StrokeDashArray="6 3" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotate"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Canvas>
                </Viewbox>

                <TextBlock x:Name="LoadingText"
                       Text="Loading images..."
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Toast overlay (always last so it floats above loader too) -->
        <Border x:Name="ToastMessage"
            Background="#333"
            CornerRadius="5"
            Padding="10"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="20"
            Visibility="Collapsed"
            Opacity="0">
            <TextBlock x:Name="ToastText"
                   Foreground="White"
                   FontSize="12"
                   Text=""/>
        </Border>
    </Grid>


</Window>