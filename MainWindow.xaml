<Window x:Class="PicSerial.MainWindow"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PicSerial"
        Height="auto"
        Width="600"
        xmlns:local="clr-namespace:PicSerial"
        >
    <Grid>
        <DockPanel LastChildFill="True">

            <!-- Top toolbar -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="#EEE" Height="22">
                <!-- Buttons on the left -->
                <Button x:Name="BtnNewFolder" Content="New Folder" Margin="5,0" Click="BtnNewFolder_Click"/>
                <Button x:Name="BtnOpenFolder" Content="Open Folder" Margin="5,0" Click="BtnOpenFolder_Click"/>
                <Button x:Name="BtnClearPreviews" Content="Clear Previews" Margin="5,0"  Click="BtnClearPreviews_Click"/>
                <Button x:Name="BtnShowFolder" Content="Show Folder" Margin="5,0"  Click="BtnShowFolder_Click"/>

                <!-- Spacer pushes status bar items to the right -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <StatusBar Background="#EEE" Height="22">
                        <StatusBarItem>
                            <TextBlock x:Name="StatusFolder" Text="No folder selected" FontSize="11"/>
                        </StatusBarItem>
                        <StatusBarItem>
                            <TextBlock x:Name="StatusCounter" Text="Images copied: 0" FontSize="11"/>
                        </StatusBarItem>
                    </StatusBar>
                </StackPanel>
            </StackPanel>

            <!-- Drag area and other content -->
            <Border DockPanel.Dock="Top"  Height="auto" Margin="5" BorderBrush="Gray"
                    BorderThickness="2"
                    AllowDrop="True"
                    DragEnter="DragArea_DragEnter"
                    Drop="DragArea_Drop"
                    Background="LightGray">
                <!-- Drag-drop zone -->
                <ScrollViewer MinHeight="400" Height="auto">
                    <WrapPanel x:Name="PreviewPanel" Orientation="Horizontal"/>
                </ScrollViewer>
            </Border>

            <!-- Rest of your layout -->
        </DockPanel>

        <!-- Loader overlay (dims background, centered spinner + message) -->
        <Grid x:Name="LoaderOverlay"
          Background="#80000000"
          Visibility="Collapsed"
          Opacity="0">
            <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Vertical"
                    Margin="20">
                <Viewbox Width="100" Height="100" Margin="0,0,0,15">
                    <Canvas Width="100" Height="100">
                        <Ellipse Width="60" Height="60" Stroke="White" StrokeThickness="6"
                             StrokeDashArray="6 3" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotate"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Canvas>
                </Viewbox>

                <TextBlock x:Name="LoadingText"
                       Text="Loading images..."
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Toast overlay (always last so it floats above loader too) -->
        <Border x:Name="ToastMessage"
            Background="#333"
            CornerRadius="5"
            Padding="10"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="20"
            Visibility="Collapsed"
            Opacity="0">
            <TextBlock x:Name="ToastText"
                   Foreground="White"
                   FontSize="12"
                   Text=""/>
        </Border>
    </Grid>


</Window>